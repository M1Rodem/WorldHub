<Window x:Class="WorldHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorldHub.App.Views"
        Title="WorldHub"
        Width="1200"
        Height="750"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style TargetType="Button">

            <Setter Property="Background"
                    Value="#18263F"/>

            <Setter Property="Foreground"
                    Value="#E8EEF8"/>

            <Setter Property="BorderBrush"
                    Value="#263957"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="12,0"/>

        </Style>

    </Window.Resources>

    <Grid Background="#0B1220">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="240"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="#101A2D"
                BorderBrush="#1D2A42"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel>

                    <TextBlock Text="WORLDHUB"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Minecraft Co-op"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#71809A"/>

                </StackPanel>


                <StackPanel Grid.Row="1"
                            Margin="0,40,0,0">

                    <Button Content="Главная"
                            Height="46"
                            Margin="0,0,0,8"/>

                    <Button Content="Мои миры"
                            Height="46"
                            Margin="0,0,0,8"
                            Click="MyWorldsButton_Click"/>

                    <Button Content="Подключение"
                        Height="46"
                        Margin="0,0,0,8"
                        Click="ConnectionNavigationButton_Click"/>

                    <Button Content="История"
                            Height="46"
                            Margin="0,0,0,8"
                            Click="HistoryNavigationButton_Click"/>

                    <Button Content="Настройки"
                        Height="46"
                        Click="SettingsNavigationButton_Click"/>

                </StackPanel>


                <Border Grid.Row="2"
                        Padding="12"
                        Background="#16233A"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Состояние"
                                   FontSize="11"
                                   Foreground="#71809A"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,5,0,0">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#45D483"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text=" Готов"
                                       Foreground="#DCE5F5"
                                       Margin="5,0,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- MAIN -->

        <Grid Grid.Column="1"
              Margin="32">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- HEADER -->

            <StackPanel>

                <TextBlock x:Name="PageTitleText"
                           Text="Мои миры"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock x:Name="PageDescriptionText"
                           Text="Управляйте мирами, версиями и подключениями"
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#71809A"/>

            </StackPanel>


            <!-- CONTENT -->

            <Grid Grid.Row="1"
                  Margin="0,30,0,0">


                <!-- ==================== -->
                <!-- MY WORLDS -->
                <!-- ==================== -->

                <Grid x:Name="WorldsPage">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ACTIONS -->

                    <StackPanel Orientation="Horizontal">

                        <Button Content="+ Подключить мир"
                                Width="170"
                                Height="40"
                                Click="AddWorldButton_Click"/>

                        <Button Content="Подключиться к другу"
                            Width="190"
                            Height="40"
                            Margin="10,0,0,0"
                            Click="ConnectionNavigationButton_Click"/>

                    </StackPanel>


                    <!-- EMPTY STATE -->

                    <Border x:Name="EmptyState"
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            Background="#101A2D"
                            BorderBrush="#1D2A42"
                            BorderThickness="1"
                            CornerRadius="12">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Миров пока нет"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Подключите существующий Minecraft-мир, чтобы начать"
                                       Margin="0,10,0,20"
                                       Foreground="#71809A"
                                       HorizontalAlignment="Center"/>

                            <Button Content="Подключить первый мир"
                                    Width="190"
                                    Height="42"
                                    Click="AddWorldButton_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- WORLD LIST -->

                    <ScrollViewer x:Name="WorldsList"
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="WorldsItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Margin="0,0,0,12"
                                            Padding="20"
                                            Background="#101A2D"
                                            BorderBrush="#1D2A42"
                                            BorderThickness="1"
                                            CornerRadius="12">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>


                                            <StackPanel>

                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>

                                                <TextBlock Text="{Binding LocalPath}"
                                                           Margin="0,6,0,0"
                                                           FontSize="12"
                                                           Foreground="#71809A"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,10,0,0">

                                                    <TextBlock Text="{Binding MinecraftVersion}"
                                                               Foreground="#A9B7CC"/>

                                                    <TextBlock Text=" • "
                                                               Foreground="#52627B"/>

                                                    <TextBlock Text="{Binding Loader}"
                                                               Foreground="#A9B7CC"/>

                                                    <TextBlock Text=" • "
                                                               Foreground="#52627B"/>

                                                    <TextBlock Text="{Binding VersionText}"
                                                               Foreground="#A9B7CC"/>

                                                </StackPanel>

                                            </StackPanel>


                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <Button Content="Отправить"
                                                        Width="100"
                                                        Height="38"
                                                        Margin="8,0,0,0"
                                                        Click="PushWorldButton_Click"/>

                                                <Button Content="Получить"
                                                        Width="100"
                                                        Height="38"
                                                        Margin="8,0,0,0"
                                                        Click="PullWorldButton_Click"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>


                <!-- ==================== -->
                <!-- HISTORY -->
                <!-- ==================== -->

                <Grid x:Name="HistoryPage"
                      Visibility="Collapsed">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="HistoryWorldsList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="0,0,0,24">

                                        <TextBlock Text="{Binding WorldName}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding WorldPath}"
                                                   Margin="0,5,0,12"
                                                   FontSize="12"
                                                   Foreground="#71809A"/>


                                        <ItemsControl ItemsSource="{Binding Snapshots}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Margin="0,0,0,10"
                                                            Padding="16"
                                                            Background="#101A2D"
                                                            BorderBrush="#1D2A42"
                                                            BorderThickness="1"
                                                            CornerRadius="10">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>


                                                            <StackPanel>

                                                                <TextBlock Text="{Binding VersionText}"
                                                                           FontSize="17"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"/>

                                                                <TextBlock Text="{Binding CreatedText}"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="12"
                                                                           Foreground="#71809A"/>

                                                                <TextBlock Text="{Binding Message}"
                                                                           Margin="0,8,0,0"
                                                                           Foreground="#A9B7CC"/>

                                                                <TextBlock Text="{Binding ShortHash}"
                                                                           Margin="0,8,0,0"
                                                                           FontSize="11"
                                                                           Foreground="#52627B"/>

                                                            </StackPanel>


                                                            <Button Grid.Column="1"
                                                                Content="Восстановить"
                                                                Width="130"
                                                                Height="38"
                                                                VerticalAlignment="Center"
                                                                Click="RestoreSnapshotButton_Click"/>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

                <views:SettingsView x:Name="SettingsPage"
                    Visibility="Collapsed"/>

                <views:ConnectionView x:Name="ConnectionPage"
                      Visibility="Collapsed"/>

            </Grid>

        </Grid>

    </Grid>

</Window>