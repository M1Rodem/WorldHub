<Window
    x:Class="WorldHub.App.Views.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="WorldHub"
    Width="1024"
    Height="760"
    MinWidth="900"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0">

            <Grid>

                <!-- BRAND -->
                <StackPanel
                    Margin="24,24,24,0">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Width="26"
                            Height="26"
                            CornerRadius="6"
                            Background="{DynamicResource AccentPurpleSubtleBrush}"
                            BorderBrush="{DynamicResource AccentPurpleBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                            <svgc:SvgViewbox
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="/Assets/Icons/server.svg"/>
                        </Border>
                        <TextBlock
                            Text="WorldHub"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="18"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock
                        Margin="36,4,0,0"
                        Text="SERVER MANAGER"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                </StackPanel>

                <!-- NAVIGATION -->
                <StackPanel
                    Margin="12,84,12,0">

                    <!-- МОИ СЕРВЕРЫ -->
                    <Button
                        x:Name="ServersNavButton"
                        Style="{StaticResource SidebarNavButton}"
                        Margin="0,0,0,6"
                        Click="ServersNavigationButton_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/server.svg"/>

                            <TextBlock
                                x:Name="ServersNavText"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Мои серверы"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                        </StackPanel>

                    </Button>


                    <!-- ПОДКЛЮЧЕНИЕ -->
                    <Button
                        x:Name="ConnectionNavButton"
                        Style="{StaticResource SidebarNavButton}"
                        Margin="0,0,0,6"
                        Click="ConnectionNavigationButton_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/connection.svg"/>

                            <TextBlock
                                x:Name="ConnectionNavText"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Подключение"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>


                    <!-- НАСТРОЙКИ -->
                    <Button
                        x:Name="SettingsNavButton"
                        Style="{StaticResource SidebarNavButton}"
                        Click="SettingsNavigationButton_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/settings.svg"/>

                            <TextBlock
                                x:Name="SettingsNavText"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Настройки"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- SIDEBAR FOOTER -->
                <Border
                    VerticalAlignment="Bottom"
                    Margin="12,0,12,16"
                    Padding="10,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBlock
                            Text="WorldHub • v1.0"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <Grid
            Grid.Column="1"
            Margin="32,0,32,32">

            <ContentControl
                x:Name="ContentHost"/>

        </Grid>

    </Grid>

</Window>