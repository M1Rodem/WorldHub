<Window
    x:Class="WorldHub.App.Views.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="WorldHub"
    Width="1024"
    Height="760"
    MinWidth="900"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="#0E1117"
    Foreground="#F2F4F7"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid Background="#0E1117">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border
            Grid.Column="0"
            Background="#151922"
            BorderBrush="#2A303B"
            BorderThickness="0,0,1,0">

            <Grid>

                <!-- BRAND -->
                <StackPanel
                    Margin="24,22,24,0">

                    <TextBlock
                        Text="WorldHub"
                        FontFamily="Inter"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#F2F4F7"/>

                    <TextBlock
                        Margin="0,6,0,0"
                        Text="SERVER MANAGER"
                        FontFamily="Inter"
                        FontSize="9"
                        FontWeight="Medium"
                        Foreground="#8C95A3"/>

                </StackPanel>

                <!-- NAVIGATION -->
                <StackPanel
                    Margin="12,78,12,0">

                    <!-- МОИ СЕРВЕРЫ -->
                    <Button
                        x:Name="ServersNavButton"
                        Width="196"
                        Height="38"
                        Padding="0"
                        Background="#1A1F29"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Foreground="#F2F4F7"
                        Click="ServersNavigationButton_Click">

                        <StackPanel
                            Width="196"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="18"
                                Height="18"
                                Margin="13,0,0,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/server.svg"/>

                            <TextBlock
                                x:Name="ServersNavText"
                                Margin="11,0,0,0"
                                VerticalAlignment="Center"
                                Text="Мои серверы"
                                FontFamily="Inter"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#F2F4F7"/>

                        </StackPanel>

                    </Button>


                    <!-- ПОДКЛЮЧЕНИЕ -->
                    <Button
                        x:Name="ConnectionNavButton"
                        Width="196"
                        Height="38"
                        Margin="0,8,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Foreground="#8C95A3"
                        Click="ConnectionNavigationButton_Click">

                        <StackPanel
                            Width="196"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="18"
                                Height="18"
                                Margin="13,0,0,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/connection.svg"/>

                            <TextBlock
                                x:Name="ConnectionNavText"
                                Margin="11,0,0,0"
                                VerticalAlignment="Center"
                                Text="Подключение"
                                FontFamily="Inter"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#8C95A3"/>
                        </StackPanel>
                    </Button>


                    <!-- НАСТРОЙКИ -->
                    <Button
                        x:Name="SettingsNavButton"
                        Width="196"
                        Height="38"
                        Margin="0,8,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Foreground="#8C95A3"
                        Click="SettingsNavigationButton_Click">

                        <StackPanel
                            Width="196"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="18"
                                Height="18"
                                Margin="13,0,0,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/settings.svg"/>

                            <TextBlock
                                x:Name="SettingsNavText"
                                Margin="11,0,0,0"
                                VerticalAlignment="Center"
                                Text="Настройки"
                                FontFamily="Inter"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#8C95A3"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <Grid
            Grid.Column="1"
            Margin="32,0,32,32">

            <ContentControl
                x:Name="ContentHost"/>

        </Grid>

    </Grid>

</Window>