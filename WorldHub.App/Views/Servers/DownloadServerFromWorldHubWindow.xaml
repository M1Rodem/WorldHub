<Window
    x:Class="WorldHub.App.Views.Servers.DownloadServerFromWorldHubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="Скачать сервер из WorldHub"
    Width="560"
    Height="620"
    MinWidth="560"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ShowInTaskbar="False">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel>
            <TextBlock
                Text="Скачать сервер из WorldHub"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock
                Margin="0,5,0,0"
                Text="Загрузка и установка Minecraft-сервера из общей папки Google Drive"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- CONTENT -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,20,0,0"
            VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- WORLDHUB SERVER SELECTION -->
                <TextBlock
                    Text="WorldHub-сервер"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="11"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextMutedBrush}"/>

                <ComboBox
                    x:Name="WorldHubServerComboBox"
                    Height="38"
                    Margin="0,6,0,16"
                    Padding="12,0"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    SelectionChanged="WorldHubServerComboBox_SelectionChanged"/>

                <!-- STATUS MESSAGE / LOADING -->
                <TextBlock
                    x:Name="StatusMessageTextBlock"
                    Text="Выберите WorldHub-сервер из списка выше."
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,16"/>

                <!-- MANIFEST CARD -->
                <Border
                    x:Name="ServerInfoCard"
                    Style="{StaticResource InnerCardBorder}"
                    Padding="16"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock
                            Text="Обнаружен пакет сервера в облаке"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Server Name -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Название сервера"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock
                                x:Name="ServerNameTextBlock"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="—"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- MC Version -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,8,0,0"
                                Text="Версия Minecraft"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock
                                x:Name="MinecraftVersionTextBlock"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Text="—"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Loader -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,8,0,0"
                                Text="Загрузчик"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock
                                x:Name="LoaderTextBlock"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Text="—"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Pushed By -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,8,0,0"
                                Text="Выгрузил хост"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock
                                x:Name="PushedByTextBlock"
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Text="—"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Archive Size -->
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,8,0,0"
                                Text="Размер архива"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock
                                x:Name="ArchiveSizeTextBlock"
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Text="—"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- TARGET FOLDER -->
                <StackPanel
                    x:Name="DestinationFolderPanel"
                    Visibility="Collapsed">

                    <TextBlock
                        Text="Папка для установки на вашем ПК"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                    <Grid Margin="0,6,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="DestinationPathTextBox"
                            Height="38"
                            Padding="10,0"
                            VerticalContentAlignment="Center"/>

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Width="98"
                            Height="38"
                            Margin="8,0,0,0"
                            Content="Обзор..."
                            Click="BrowseFolderButton_Click"/>
                    </Grid>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <!-- ACTIONS -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Style="{StaticResource SecondaryButton}"
                Width="96"
                Height="36"
                Margin="0,0,8,0"
                Content="Отмена"
                Click="CancelButton_Click"/>

            <Button
                x:Name="DownloadButton"
                Style="{StaticResource PrimaryButton}"
                Height="36"
                Padding="16,0"
                Content="Скачать и установить"
                IsEnabled="False"
                Click="DownloadButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
