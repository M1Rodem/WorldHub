<UserControl
    x:Class="WorldHub.App.Views.Servers.ServersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">

    <Grid>

        <!-- HEADER -->
        <Grid
            Margin="0,20,0,0"
            VerticalAlignment="Top">

            <StackPanel
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Мои серверы"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType" />

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Локальные Minecraft Dedicated Server"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType" />

            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button
                    x:Name="HeaderDownloadServerButton"
                    Style="{StaticResource SecondaryButton}"
                    Height="36"
                    Margin="0,0,10,0"
                    Padding="16,0"
                    Click="DownloadServerButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <svgc:SvgViewbox
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Stretch="Uniform"
                            Source="/Assets/Icons/download.svg" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Скачать из WorldHub"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimaryBrush}" />

                    </StackPanel>

                </Button>

                <Button
                    x:Name="HeaderAddServerButton"
                    Style="{StaticResource PrimaryButton}"
                    Width="168"
                    Height="36"
                    Click="AddServerButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <svgc:SvgViewbox
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Stretch="Uniform"
                            Source="/Assets/Icons/plus.svg" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Добавить сервер"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#FFFFFF" />

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>


        <!-- EMPTY STATE -->
        <Border
            x:Name="EmptyState"
            Style="{StaticResource CardBorder}"
            Margin="0,110,0,0"
            Padding="40,48"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch">

            <StackPanel
                HorizontalAlignment="Center">

                <Border
                    Width="52"
                    Height="52"
                    CornerRadius="12"
                    Background="{DynamicResource AccentPurpleSubtleBrush}"
                    BorderBrush="{DynamicResource AccentPurpleBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                    <svgc:SvgViewbox
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Source="/Assets/Icons/server.svg" />
                </Border>

                <TextBlock
                    Text="У вас пока нет серверов"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Margin="0,8,0,24"
                    Text="Добавьте локальный Minecraft Dedicated Server для управления и синхронизации."
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="13"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    HorizontalAlignment="Center" />

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Height="36"
                        Margin="0,0,10,0"
                        Padding="16,0"
                        Click="DownloadServerButton_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="14"
                                Height="14"
                                Margin="0,0,8,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/download.svg" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Скачать из WorldHub"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimaryBrush}" />

                        </StackPanel>

                    </Button>

                    <Button
                        Style="{StaticResource PrimaryButton}"
                        Width="168"
                        Height="36"
                        Click="AddServerButton_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="14"
                                Height="14"
                                Margin="0,0,8,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/plus.svg" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Добавить сервер"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#FFFFFF" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </StackPanel>

        </Border>


        <!-- SERVER LIST -->
        <ScrollViewer
            x:Name="ServersList"
            Margin="0,84,0,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">

            <ItemsControl
                x:Name="ServersItemsControl">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Style="{StaticResource CardBorder}"
                            Margin="0,0,0,12"
                            Padding="20">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- TOP ROW: ICON + NAME + STATUS -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ICON -->
                                    <Border
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                        <svgc:SvgViewbox
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Source="/Assets/Icons/server.svg" />
                                    </Border>

                                    <!-- NAME -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!-- STATUS PILL -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,4"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Fill="{Binding StatusBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding StatusText}"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                    </Border>

                                </Grid>


                                <!-- METADATA ROW -->
                                <Border
                                    Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Padding="14,10"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- PATH -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Text="Путь к серверу"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock
                                                Margin="0,3,16,0"
                                                Text="{Binding LocalPath}"
                                                TextTrimming="CharacterEllipsis"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <!-- MINECRAFT -->
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock
                                                Text="Minecraft"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Text="{Binding MinecraftVersion}"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <!-- LOADER -->
                                        <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                            <TextBlock
                                                Text="{Binding Loader}"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Text="{Binding LoaderVersion}"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <!-- SAVE VERSION -->
                                        <StackPanel Grid.Column="3" Margin="24,0,0,0">
                                            <TextBlock
                                                Text="Версия сохранения"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Text="{Binding SaveVersion}"
                                                FontFamily="Inter, Segoe UI, sans-serif"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                    </Grid>

                                </Border>


                                <!-- ACTIONS ROW -->
                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,14,0,0"
                                    Orientation="Horizontal">

                                    <!-- START / STOP -->
                                    <Button
                                        Width="120"
                                        Height="34"
                                        Padding="0"
                                        Background="{Binding ActionBackground}"
                                        BorderBrush="{Binding ActionBorderBrush}"
                                        BorderThickness="1"
                                        IsEnabled="{Binding IsActionEnabled}"
                                        Tag="{Binding}"
                                        Cursor="Hand"
                                        Click="ControlButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border
                                                    x:Name="ActionBtnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ActionBtnBorder" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding ActionText}"
                                            FontFamily="Inter, Segoe UI, sans-serif"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{Binding ActionForeground}" />

                                    </Button>

                                    <!-- SETTINGS -->
                                    <Button
                                        Style="{StaticResource IconButton}"
                                        Width="34"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Tag="{Binding}"
                                        ToolTip="Настройки"
                                        Click="OpenServerButton_Click">

                                        <svgc:SvgViewbox
                                            Width="16"
                                            Height="16"
                                            Stretch="Uniform"
                                            Source="/Assets/Icons/settings.svg" />

                                    </Button>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>