<Window
    x:Class="WorldHub.App.Views.Servers.AddServerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Добавить сервер"
    Width="520"
    Height="540"
    MinWidth="520"
    MinHeight="540"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ShowInTaskbar="False">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel>
            <TextBlock
                Text="Добавить сервер"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock
                Margin="0,5,0,0"
                Text="Добавьте локальный Minecraft Dedicated Server"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- FORM -->
        <StackPanel
            Grid.Row="1"
            Margin="0,24,0,0">

            <!-- NAME -->
            <TextBlock
                Text="Название"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource TextMutedBrush}"/>

            <TextBox
                x:Name="NameTextBox"
                Height="38"
                Margin="0,6,0,16"
                Padding="10,0"
                VerticalContentAlignment="Center"/>

            <!-- LAUNCH FILE -->
            <TextBlock
                Text="Файл запуска"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource TextMutedBrush}"/>

            <Grid Margin="0,6,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="LaunchFileTextBox"
                    Height="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    IsReadOnly="True"/>

                <Button
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Width="98"
                    Height="38"
                    Margin="8,0,0,0"
                    Content="Выбрать"
                    Click="SelectLaunchFileButton_Click"/>
            </Grid>

            <!-- DETECTION -->
            <Border
                x:Name="DetectionPanel"
                Style="{StaticResource InnerCardBorder}"
                Padding="16"
                Visibility="Collapsed">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MINECRAFT -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Minecraft"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock
                        x:Name="MinecraftVersionTextBlock"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="—"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- LOADER -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        Text="Загрузчик"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock
                        x:Name="LoaderTextBlock"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Text="—"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- LOADER VERSION -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        Text="Версия загрузчика"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock
                        x:Name="LoaderVersionTextBlock"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Text="—"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- LAUNCH TYPE -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        Text="Тип запуска"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock
                        x:Name="LaunchTypeTextBlock"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Text="—"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                </Grid>

            </Border>

        </StackPanel>

        <!-- ACTIONS -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Style="{StaticResource SecondaryButton}"
                Width="96"
                Height="36"
                Margin="0,0,8,0"
                Content="Отмена"
                Click="CancelButton_Click"/>

            <Button
                Style="{StaticResource PrimaryButton}"
                Width="120"
                Height="36"
                Content="Добавить"
                Click="AddButton_Click"/>

        </StackPanel>

    </Grid>

</Window>