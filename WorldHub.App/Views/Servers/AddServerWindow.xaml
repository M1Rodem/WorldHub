<Window
    x:Class="WorldHub.App.Views.Servers.AddServerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Добавить сервер"
    Width="520"
    Height="560"
    MinWidth="520"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#0E1117"
    Foreground="#F2F4F7"
    ShowInTaskbar="False">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel>

            <TextBlock
                Text="Добавить сервер"
                FontFamily="Inter"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#F2F4F7"/>

            <TextBlock
                Margin="0,7,0,0"
                Text="Добавьте локальный Minecraft Dedicated Server"
                FontFamily="Inter"
                FontSize="12"
                Foreground="#8C95A3"/>

        </StackPanel>


        <!-- FORM -->

        <StackPanel
            Grid.Row="1"
            Margin="0,30,0,0">

            <!-- NAME -->

            <TextBlock
                Text="Название"
                FontFamily="Inter"
                FontSize="12"
                Foreground="#8C95A3"/>

            <TextBox
                x:Name="NameTextBox"
                Height="38"
                Margin="0,7,0,20"
                Padding="10,0"
                VerticalContentAlignment="Center"
                Background="#151922"
                BorderBrush="#2A303B"
                Foreground="#F2F4F7"
                FontFamily="Inter"
                FontSize="13"/>


            <!-- LAUNCH FILE -->

            <TextBlock
                Text="Файл запуска"
                FontFamily="Inter"
                FontSize="12"
                Foreground="#8C95A3"/>

            <Grid Margin="0,7,0,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="LaunchFileTextBox"
                    Height="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    IsReadOnly="True"
                    Background="#151922"
                    BorderBrush="#2A303B"
                    Foreground="#F2F4F7"
                    FontFamily="Inter"
                    FontSize="12"/>

                <Button
                    Grid.Column="1"
                    Width="105"
                    Height="38"
                    Margin="10,0,0,0"
                    Content="Выбрать"
                    Background="#1A1F29"
                    BorderBrush="#2A303B"
                    Foreground="#F2F4F7"
                    FontFamily="Inter"
                    FontSize="12"
                    Click="SelectLaunchFileButton_Click"/>

            </Grid>


            <!-- DETECTION -->

            <Border
                x:Name="DetectionPanel"
                Padding="16"
                Background="#151922"
                BorderBrush="#2A303B"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- MINECRAFT -->

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Minecraft"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#8C95A3"/>

                    <TextBlock
                        x:Name="MinecraftVersionTextBlock"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="—"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#F2F4F7"/>


                    <!-- LOADER -->

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        Text="Загрузчик"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#8C95A3"/>

                    <TextBlock
                        x:Name="LoaderTextBlock"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Text="—"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#F2F4F7"/>


                    <!-- LOADER VERSION -->

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        Text="Версия загрузчика"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#8C95A3"/>

                    <TextBlock
                        x:Name="LoaderVersionTextBlock"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Text="—"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#F2F4F7"/>


                    <!-- LAUNCH TYPE -->

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        Text="Тип запуска"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#8C95A3"/>

                    <TextBlock
                        x:Name="LaunchTypeTextBlock"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Text="—"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#F2F4F7"/>

                </Grid>

            </Border>

        </StackPanel>


        <!-- ACTIONS -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Width="100"
                Height="38"
                Margin="0,0,10,0"
                Content="Отмена"
                Background="#1A1F29"
                BorderBrush="#2A303B"
                Foreground="#F2F4F7"
                FontFamily="Inter"
                FontSize="12"
                Click="CancelButton_Click"/>

            <Button
                Width="140"
                Height="38"
                Content="Добавить"
                Background="#4C8DFF"
                BorderBrush="#2A303B"
                Foreground="White"
                FontFamily="Inter"
                FontSize="12"
                Click="AddButton_Click"/>

        </StackPanel>

    </Grid>

</Window>