<UserControl
    x:Class="WorldHub.App.Views.Servers.MinecraftServerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="0,20,15,32">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SERVER HEADER -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Border
                            Width="38"
                            Height="38"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <svgc:SvgViewbox
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="/Assets/Icons/server.svg"/>
                        </Border>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">

                            <TextBlock
                                x:Name="ServerNameTextBlock"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock
                                Margin="0,3,0,0"
                                Text="Настройки локального Minecraft Dedicated Server"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- ACTIONS (BACK) -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Width="96"
                            Height="34"
                            ToolTip="Назад к списку серверов"
                            Click="BackButton_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <svgc:SvgViewbox
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    Stretch="Uniform"
                                    Source="/Assets/Icons/arrow-left.svg"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Назад"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimaryBrush}"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

                <!-- MAIN PARAMETERS -->
                <TextBlock
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    Text="Основные параметры"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Border
                    Grid.Row="2"
                    Style="{StaticResource CardBorder}"
                    Margin="0,12,0,0"
                    Padding="20">

                    <StackPanel>

                        <!-- WORLDHUB SERVER -->
                        <TextBlock
                            Text="WorldHub-сервер"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextMutedBrush}"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                x:Name="WorldHubServerComboBox"
                                Grid.Column="0"
                                Height="38"
                                Margin="0,0,10,0"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectionChanged="WorldHubServerComboBox_SelectionChanged"/>

                            <Button
                                x:Name="SaveWorldHubServerButton"
                                Grid.Column="1"
                                Content="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Height="38"
                                Padding="20,0"
                                Click="SaveWorldHubServerButton_Click"/>
                        </Grid>

                        <!-- PATH -->
                        <TextBlock
                            Margin="0,14,0,0"
                            Text="Путь к серверу"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextMutedBrush}"/>

                        <Grid Margin="0,6,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource InnerCardBorder}"
                                Height="38"
                                Margin="0,0,10,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <svgc:SvgViewbox
                                        Grid.Column="0"
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        Source="/Assets/Icons/folder.svg"/>

                                    <TextBlock
                                        x:Name="ServerPathTextBlock"
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                                </Grid>

                            </Border>

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="38"
                                Width="88"
                                Content="Выбрать"/>

                        </Grid>

                        <!-- MINECRAFT / LOADER -->
                        <Grid Margin="0,14,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Minecraft"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextMutedBrush}"/>

                                <Border
                                    Style="{StaticResource InnerCardBorder}"
                                    Height="38"
                                    Margin="0,6,6,0">

                                    <TextBlock
                                        x:Name="MinecraftVersionTextBlock"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                                </Border>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="Загрузчик"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextMutedBrush}"/>

                                <Border
                                    Style="{StaticResource InnerCardBorder}"
                                    Height="38"
                                    Margin="6,6,0,0">

                                    <TextBlock
                                        x:Name="LoaderTextBlock"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                                </Border>

                            </StackPanel>

                        </Grid>

                        <!-- LOADER VERSION -->
                        <TextBlock
                            Margin="0,14,0,0"
                            Text="Версия загрузчика"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextMutedBrush}"/>

                        <Border
                            Style="{StaticResource InnerCardBorder}"
                            Height="38"
                            Margin="0,6,0,0">

                            <TextBlock
                                x:Name="LoaderVersionTextBlock"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- CLOUD -->
                <TextBlock
                    Grid.Row="3"
                    Margin="0,26,0,0"
                    Text="Облако"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Border
                    Grid.Row="4"
                    Style="{StaticResource CardBorder}"
                    Margin="0,12,0,0"
                    Padding="18,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <svgc:SvgViewbox
                                x:Name="CloudStatusIcon"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="/Assets/Icons/google-off.svg"/>

                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Google Drive"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal">

                                <Ellipse
                                    x:Name="CloudStatusDot"
                                    Width="6"
                                    Height="6"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource TextMutedBrush}"/>

                                <TextBlock
                                    x:Name="CloudStatusTextBlock"
                                    Text="Не привязан к WorldHub-серверу"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}"/>

                            </StackPanel>

                            <TextBlock
                                x:Name="CloudFolderHintTextBlock"
                                Margin="0,3,0,0"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Visibility="Collapsed"/>

                        </StackPanel>

                        <Button
                            x:Name="OpenCloudFolderButton"
                            Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Height="34"
                            Padding="14,0"
                            VerticalAlignment="Center"
                            Content="Открыть в Google Drive"
                            IsEnabled="False"
                            Click="OpenCloudFolderButton_Click"/>

                    </Grid>

                </Border>

                <!-- SYNC -->
                <Grid
                    Grid.Row="5"
                    Margin="0,26,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Синхронизация"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Orientation="Horizontal">

                        <Button
                            x:Name="PushButton"
                            Style="{StaticResource SecondaryButton}"
                            Width="108"
                            Height="34"
                            Click="PushButton_Click">

                            <StackPanel Orientation="Horizontal">

                                <svgc:SvgViewbox
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    Stretch="Uniform"
                                    Source="/Assets/Icons/upload.svg"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Push"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="12"/>

                            </StackPanel>

                        </Button>

                        <Button
                            x:Name="PullButton"
                            Style="{StaticResource SecondaryButton}"
                            Width="108"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="PullButton_Click">

                            <StackPanel Orientation="Horizontal">

                                <svgc:SvgViewbox
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    Stretch="Uniform"
                                    Source="/Assets/Icons/download.svg"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Pull"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="12"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        Text="Изменения выполняются только при остановленном сервере."
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"/>

                    <!-- SERVER ACTION + STATUS + DELETE -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">

                        <Button
                            x:Name="ServerActionButton"
                            Style="{StaticResource PrimaryButton}"
                            Width="170"
                            Height="36"
                            Click="ServerActionButton_Click"/>

                        <StackPanel
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <Ellipse
                                x:Name="StatusIndicator"
                                Width="6"
                                Height="6"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource TextMutedBrush}"/>

                            <TextBlock
                                x:Name="StatusTextBlock"
                                VerticalAlignment="Center"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>

                        </StackPanel>

                        <Button
                            x:Name="DeleteServerButton"
                            Style="{StaticResource DangerButton}"
                            Height="36"
                            Padding="14,0"
                            Margin="24,0,0,0"
                            ToolTip="Удалить сервер из программы (файлы останутся на диске)"
                            Click="DeleteServerButton_Click">

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Удалить сервер"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#FFFFFF"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>
</UserControl>