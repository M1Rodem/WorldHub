<UserControl
    x:Class="WorldHub.App.Views.Servers.MinecraftServerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Background="#0E1117">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="0,20,15,32">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SERVER HEADER -->

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal">

                        <Border
                            Width="38"
                            Height="38"
                            Background="#151922"
                            BorderBrush="#2A303B"
                            BorderThickness="1"
                            CornerRadius="8">

                            <svgc:SvgViewbox
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="/Assets/Icons/server.svg"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">

                            <TextBlock
                                x:Name="ServerNameTextBlock"
                                FontFamily="Inter"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#F2F4F7"/>

                            <TextBlock
                                Margin="0,4,0,0"
                                Text="Настройки локального Minecraft Dedicated Server"
                                FontFamily="Inter"
                                FontSize="12"
                                Foreground="#8C95A3"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- BACK -->

                    <Button
                        Grid.Column="1"
                        Width="112"
                        Height="38"
                        Padding="0"
                        Background="#151922"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        ToolTip="Назад"
                        Click="BackButton_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <svgc:SvgViewbox
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/arrow-left.svg"/>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Назад"
                                FontFamily="Inter"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#F2F4F7"/>

                        </StackPanel>

                    </Button>

                </Grid>

                <!-- MAIN PARAMETERS -->

                <TextBlock
                    Grid.Row="1"
                    Margin="0,32,0,0"
                    Text="Основные параметры"
                    FontFamily="Inter"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#F2F4F7"/>

                <Border
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="20"
                    Background="#151922"
                    BorderBrush="#2A303B"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <!-- WORLDHUB SERVER -->

                        <TextBlock
                            Text="WorldHub-сервер"
                            FontFamily="Inter"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#8C95A3"/>

                        <ComboBox
                            x:Name="WorldHubServerComboBox"
                            Height="42"
                            Margin="0,7,0,0"
                            Padding="12,0"
                            Background="#1A1F29"
                            BorderBrush="#2A303B"
                            BorderThickness="1"
                            Foreground="#F2F4F7"
                            FontFamily="Inter"
                            FontSize="13"
                            VerticalContentAlignment="Center"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Id"
                            SelectionChanged="WorldHubServerComboBox_SelectionChanged"/>

                        <!-- PATH -->

                        <Grid Margin="0,7,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Height="42"
                                Margin="0,0,15,0"
                                Background="#1A1F29"
                                BorderBrush="#2A303B"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <svgc:SvgViewbox
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        Source="/Assets/Icons/folder.svg"/>

                                    <TextBlock
                                        x:Name="ServerPathTextBlock"
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        FontFamily="Inter"
                                        FontSize="13"
                                        Foreground="#F2F4F7"/>

                                </Grid>

                            </Border>

                            <Button
                                Grid.Column="1"
                                Height="40"
                                Content="Выбрать"
                                Background="#1A1F29"
                                BorderBrush="#2A303B"
                                Foreground="#F2F4F7"/>

                        </Grid>

                        <!-- MINECRAFT / LOADER -->

                        <Grid Margin="0,16,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Minecraft"
                                    FontFamily="Inter"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="#8C95A3"/>

                                <Border
                                    Height="42"
                                    Margin="0,7,6,0"
                                    Background="#1A1F29"
                                    BorderBrush="#2A303B"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <TextBlock
                                        x:Name="MinecraftVersionTextBlock"
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Inter"
                                        FontSize="13"
                                        Foreground="#F2F4F7"/>

                                </Border>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="Загрузчик"
                                    FontFamily="Inter"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="#8C95A3"/>

                                <Border
                                    Height="42"
                                    Margin="6,7,0,0"
                                    Background="#1A1F29"
                                    BorderBrush="#2A303B"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <TextBlock
                                        x:Name="LoaderTextBlock"
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Inter"
                                        FontSize="13"
                                        Foreground="#F2F4F7"/>

                                </Border>

                            </StackPanel>

                        </Grid>

                        <!-- LOADER VERSION -->

                        <TextBlock
                            Margin="0,16,0,0"
                            Text="Версия загрузчика"
                            FontFamily="Inter"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#8C95A3"/>

                        <Border
                            Height="42"
                            Margin="0,7,0,0"
                            Background="#1A1F29"
                            BorderBrush="#2A303B"
                            BorderThickness="1"
                            CornerRadius="6">

                            <TextBlock
                                x:Name="LoaderVersionTextBlock"
                                Margin="14,0"
                                VerticalAlignment="Center"
                                FontFamily="Inter"
                                FontSize="13"
                                Foreground="#F2F4F7"/>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- CLOUD -->

                <TextBlock
                    Grid.Row="3"
                    Margin="0,30,0,0"
                    Text="Облако"
                    FontFamily="Inter"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#F2F4F7"/>

                <Border
                    Grid.Row="4"
                    Height="82"
                    Margin="0,14,0,0"
                    Background="#151922"
                    BorderBrush="#2A303B"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1A1F29"
                            CornerRadius="7">

                            <svgc:SvgViewbox
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="/Assets/Icons/google-off.svg"/>

                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Google Drive"
                                FontFamily="Inter"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#F2F4F7"/>

                            <StackPanel
                                Margin="0,5,0,0"
                                Orientation="Horizontal">

                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Margin="0,5,8,0"
                                    Fill="#8C95A3"/>

                                <TextBlock
                                    Text="Подключение ещё не настроено"
                                    FontFamily="Inter"
                                    FontSize="12"
                                    Foreground="#8C95A3"/>

                            </StackPanel>

                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Width="190"
                            Height="38"
                            Margin="0,0,18,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="Открыть в Google Drive"
                            Background="#1A1F29"
                            BorderBrush="#2A303B"
                            Foreground="#F2F4F7"/>

                    </Grid>

                </Border>

                <!-- SYNC -->

                <Grid
                    Grid.Row="5"
                    Margin="0,30,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Синхронизация"
                        FontFamily="Inter"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F2F4F7"/>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Orientation="Horizontal">

                        <Button
                            Width="116"
                            Height="40"
                            Background="#1A1F29"
                            BorderBrush="#2A303B"
                            Foreground="#F2F4F7">

                            <StackPanel Orientation="Horizontal">

                                <svgc:SvgViewbox
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Stretch="Uniform"
                                    Source="/Assets/Icons/upload.svg"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Push"
                                    FontFamily="Inter"
                                    FontSize="12"/>

                            </StackPanel>

                        </Button>

                        <Button
                            Width="116"
                            Height="40"
                            Margin="8,0,0,0"
                            Background="#1A1F29"
                            BorderBrush="#2A303B"
                            Foreground="#F2F4F7">

                            <StackPanel Orientation="Horizontal">

                                <svgc:SvgViewbox
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Stretch="Uniform"
                                    Source="/Assets/Icons/download.svg"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Pull"
                                    FontFamily="Inter"
                                    FontSize="12"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Text="Изменения выполняются только при остановленном сервере."
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#8C95A3"/>

                    <!-- SERVER ACTION + STATUS -->

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">

                        <Button
                            x:Name="ServerActionButton"
                            Width="170"
                            Height="40"
                            Background="#4C8DFF"
                            BorderBrush="#4C8DFF"
                            Foreground="White"
                            Click="ServerActionButton_Click">

                            <StackPanel Orientation="Horizontal">

                                <svgc:SvgViewbox
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Stretch="Uniform"
                                    Source="/Assets/Icons/server.svg"/>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Запустить сервер"
                                    FontFamily="Inter"
                                    FontSize="12"
                                    FontWeight="Medium"/>

                            </StackPanel>

                        </Button>

                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <Ellipse
                                x:Name="StatusIndicator"
                                Width="7"
                                Height="7"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="#8C95A3"/>

                            <TextBlock
                                x:Name="StatusTextBlock"
                                VerticalAlignment="Center"
                                FontFamily="Inter"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#8C95A3"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>
</UserControl>