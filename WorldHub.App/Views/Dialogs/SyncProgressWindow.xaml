<Window x:Class="WorldHub.App.Views.Dialogs.SyncProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Width="480"
        SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Margin="14"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.5"
                              Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        Background="{DynamicResource AccentPurpleSubtleBrush}"
                        BorderBrush="{DynamicResource AccentPurpleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <svgc:SvgViewbox x:Name="OperationIcon"
                                     Width="18"
                                     Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform"
                                     Source="/Assets/Icons/cloud.svg"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Синхронизация мира"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock x:Name="SubtitleText"
                               Margin="0,2,0,0"
                               Text="Синхронизация через Google Drive..."
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- STATUS MESSAGE -->
            <TextBlock x:Name="StatusMessageText"
                       Grid.Row="1"
                       Margin="0,20,0,0"
                       Text="Подготовка..."
                       FontFamily="Inter, Segoe UI, sans-serif"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- PROGRESS BAR -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <ProgressBar x:Name="SyncProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="{DynamicResource AccentPurpleBrush}"
                             Background="{DynamicResource SurfaceBrush}"
                             BorderThickness="0"/>
            </Grid>

            <!-- PERCENTAGE & ACTIONS -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="PercentageText"
                           Text="0%"
                           FontFamily="Inter, Segoe UI, sans-serif"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <Button x:Name="CloseButton"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Width="100"
                        Height="32"
                        Content="Закрыть"
                        Visibility="Collapsed"
                        Click="CloseButton_Click"/>
            </Grid>

        </Grid>

    </Border>

</Window>
