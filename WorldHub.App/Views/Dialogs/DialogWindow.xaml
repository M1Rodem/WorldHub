<Window x:Class="WorldHub.App.Views.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Margin="14"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.5"
                              Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBorder"
                        Width="36"
                        Height="36"
                        Background="{DynamicResource AccentPurpleSubtleBrush}"
                        BorderBrush="{DynamicResource AccentPurpleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        VerticalAlignment="Center">

                    <TextBlock x:Name="IconText"
                               Text="!"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentPurpleBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           FontFamily="Inter, Segoe UI, sans-serif"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- MESSAGE -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="48,14,0,0"
                       FontFamily="Inter, Segoe UI, sans-serif"
                       FontSize="13"
                       LineHeight="20"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- PATHS -->
            <StackPanel x:Name="PathPanel"
                        Grid.Row="2"
                        Margin="48,14,0,0"
                        Visibility="Collapsed">

                <TextBlock Text="Откуда"
                           FontFamily="Inter, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMutedBrush}"/>

                <Border Margin="0,4,0,10"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock x:Name="FromPathText"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Куда"
                           FontFamily="Inter, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMutedBrush}"/>

                <Border Margin="0,4,0,0"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock x:Name="ToPathText"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>

            <!-- BUTTONS -->
            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">

                <Button x:Name="SecondaryButton"
                        Style="{StaticResource SecondaryButton}"
                        Width="104"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Отмена"
                        Visibility="Collapsed"
                        Click="SecondaryButton_Click"/>

                <Button x:Name="PrimaryButton"
                        Style="{StaticResource PrimaryButton}"
                        Width="104"
                        Height="34"
                        Content="Понятно"
                        Click="PrimaryButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>