<UserControl x:Class="WorldHub.App.Views.Worlds.WorldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ACTIONS -->

        <StackPanel Orientation="Horizontal">

            <Button Content="+ Подключить мир"
                    Width="170"
                    Height="40"
                    Click="AddWorldButton_Click"/>

            <Button Content="Подключиться к другу"
                Width="190"
                Height="40"
                Margin="10,0,0,0"
                Click="GoToConnectionButton_Click"/>

        </StackPanel>


        <!-- EMPTY STATE -->

        <Border x:Name="EmptyState"
                Grid.Row="1"
                Margin="0,20,0,0"
                Background="#101A2D"
                BorderBrush="#1D2A42"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Миров пока нет"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Подключите существующий Minecraft-мир, чтобы начать"
                           Margin="0,10,0,20"
                           Foreground="#71809A"
                           HorizontalAlignment="Center"/>

                <Button Content="Подключить первый мир"
                        Width="190"
                        Height="42"
                        Click="AddWorldButton_Click"/>

            </StackPanel>

        </Border>


        <!-- WORLD LIST -->

        <ScrollViewer x:Name="WorldsList"
            Grid.Row="1"
            Margin="0,20,0,0"
            Visibility="Collapsed"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="WorldsItemsControl">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Margin="0,0,0,12"
                                Padding="20"
                                Background="#101A2D"
                                BorderBrush="#1D2A42"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>

                                    <TextBlock Text="{Binding LocalPath}"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="#71809A"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0">

                                        <TextBlock Text="{Binding MinecraftVersion}"
                                                   Foreground="#A9B7CC"/>

                                        <TextBlock Text=" • "
                                                   Foreground="#52627B"/>

                                        <TextBlock Text="{Binding Loader}"
                                                   Foreground="#A9B7CC"/>

                                        <TextBlock Text=" • "
                                                   Foreground="#52627B"/>

                                        <TextBlock Text="{Binding VersionText}"
                                                   Foreground="#A9B7CC"/>

                                    </StackPanel>

                                </StackPanel>


                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Button Content="Отправить"
                                            Width="100"
                                            Height="38"
                                            Margin="8,0,0,0"
                                            Click="PushWorldButton_Click"/>

                                    <Button Content="Получить"
                                            Width="100"
                                            Height="38"
                                            Margin="8,0,0,0"
                                            Click="PullWorldButton_Click"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>