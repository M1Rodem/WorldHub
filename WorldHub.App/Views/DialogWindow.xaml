<Window x:Class="WorldHub.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Margin="12"
            Background="#101A2D"
            BorderBrush="#263957"
            BorderThickness="1"
            CornerRadius="14">

        <Border.Effect>
            <DropShadowEffect BlurRadius="25"
                               ShadowDepth="0"
                               Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ERROR ICON -->
                <Border Width="42"
                        Height="42"
                        Background="#3A1820"
                        BorderBrush="#8F3043"
                        BorderThickness="1"
                        CornerRadius="21"
                        VerticalAlignment="Top">

                    <TextBlock Text="!"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#FF6B81"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- TITLE -->
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Margin="14,2,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- MESSAGE -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="66,18,0,0"
                       FontSize="13"
                       LineHeight="21"
                       Foreground="#A9B7CC"
                       TextWrapping="Wrap"/>

            <!-- BUTTON -->
            <Button Grid.Row="2"
                    Width="110"
                    Height="38"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Content="Понятно"
                    Click="OkButton_Click">

                <Button.Style>
                    <Style TargetType="Button">

                        <Setter Property="Background"
                                Value="#18263F"/>

                        <Setter Property="Foreground"
                                Value="#E8EEF8"/>

                        <Setter Property="BorderBrush"
                                Value="#304563"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="FontSize"
                                Value="13"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Setter Property="Template">

                            <Setter.Value>
                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#213452"/>

                                            <Setter Property="BorderBrush"
                                                    Value="#3B567A"/>

                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#142239"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>

                        </Setter>

                    </Style>
                </Button.Style>

            </Button>

        </Grid>

    </Border>

</Window>