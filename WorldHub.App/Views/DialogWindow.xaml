<Window x:Class="WorldHub.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Margin="12"
            Background="#101A2D"
            BorderBrush="#263957"
            BorderThickness="1"
            CornerRadius="14">

        <Border.Effect>
            <DropShadowEffect BlurRadius="25"
                               ShadowDepth="0"
                               Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBorder"
                        Width="42"
                        Height="42"
                        Background="#182A43"
                        BorderBrush="#304C72"
                        BorderThickness="1"
                        CornerRadius="21"
                        VerticalAlignment="Top">

                    <TextBlock x:Name="IconText"
                               Text="!"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#8FA8D8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Margin="14,2,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- MESSAGE -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="66,18,0,0"
                       FontSize="13"
                       LineHeight="21"
                       Foreground="#A9B7CC"
                       TextWrapping="Wrap"/>

            <!-- PATHS -->
            <StackPanel x:Name="PathPanel"
                        Grid.Row="2"
                        Margin="66,18,0,0"
                        Visibility="Collapsed">

                <TextBlock Text="Откуда"
                           FontSize="12"
                           Foreground="#71809A"/>

                <TextBlock x:Name="FromPathText"
                           Margin="0,4,0,12"
                           FontSize="12"
                           Foreground="#A9B7CC"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Куда"
                           FontSize="12"
                           Foreground="#71809A"/>

                <TextBlock x:Name="ToPathText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#A9B7CC"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- BUTTONS -->
            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button x:Name="SecondaryButton"
                        Width="110"
                        Height="38"
                        Margin="0,0,10,0"
                        Content="Отмена"
                        Visibility="Collapsed"
                        Click="SecondaryButton_Click">

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Background"
                                    Value="#18263F"/>

                            <Setter Property="Foreground"
                                    Value="#E8EEF8"/>

                            <Setter Property="BorderBrush"
                                    Value="#304563"/>

                            <Setter Property="BorderThickness"
                                    Value="1"/>

                            <Setter Property="FontSize"
                                    Value="13"/>

                            <Setter Property="Cursor"
                                    Value="Hand"/>

                            <Setter Property="Template">

                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter Property="Background"
                                                        Value="#213452"/>

                                                <Setter Property="BorderBrush"
                                                        Value="#3B567A"/>

                                            </Trigger>

                                            <Trigger Property="IsPressed"
                                                     Value="True">

                                                <Setter Property="Background"
                                                        Value="#142239"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>

                            </Setter>

                        </Style>
                    </Button.Style>

                </Button>

                <Button x:Name="PrimaryButton"
                        Width="110"
                        Height="38"
                        Content="Понятно"
                        Click="PrimaryButton_Click">

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Background"
                                    Value="#18263F"/>

                            <Setter Property="Foreground"
                                    Value="#E8EEF8"/>

                            <Setter Property="BorderBrush"
                                    Value="#304563"/>

                            <Setter Property="BorderThickness"
                                    Value="1"/>

                            <Setter Property="FontSize"
                                    Value="13"/>

                            <Setter Property="Cursor"
                                    Value="Hand"/>

                            <Setter Property="Template">

                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter Property="Background"
                                                        Value="#213452"/>

                                                <Setter Property="BorderBrush"
                                                        Value="#3B567A"/>

                                            </Trigger>

                                            <Trigger Property="IsPressed"
                                                     Value="True">

                                                <Setter Property="Background"
                                                        Value="#142239"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>

                            </Setter>

                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</Window>