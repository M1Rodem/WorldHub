<UserControl x:Class="WorldHub.App.Views.Connection.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="0,0,24,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- YOUR WORLDHUB -->

            <Border Grid.Row="0"
                    MaxWidth="680"
                    HorizontalAlignment="Left"
                    Padding="24"
                    Margin="0,0,0,18"
                    Background="#101A2D"
                    BorderBrush="#1D2A42"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="Ваш WorldHub"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Этот адрес можно отправить другу, чтобы он подключился к вашему WorldHub."
                               Margin="0,7,0,20"
                               FontSize="13"
                               Foreground="#71809A"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Адрес для подключения"
                               FontSize="12"
                               Foreground="#A9B7CC"/>

                    <Grid Margin="0,7,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="42"
                                Padding="12,0"
                                Background="#16233A"
                                BorderBrush="#263653"
                                BorderThickness="1"
                                CornerRadius="7">

                            <TextBlock x:Name="OwnAddressTextBlock"
                                       VerticalAlignment="Center"
                                       Text="Определение адреса..."
                                       FontSize="14"
                                       Foreground="#DCE5F5"/>

                        </Border>

                        <Button x:Name="CopyAddressButton"
                                Grid.Column="1"
                                Width="120"
                                Height="42"
                                Margin="10,0,0,0"
                                Content="Копировать"
                                Click="CopyAddressButton_Click"/>

                    </Grid>

                    <Border Padding="12"
                            Background="#16233A"
                            CornerRadius="7">

                        <StackPanel>

                            <TextBlock Text="Статус WorldHub"
                                       FontSize="11"
                                       Foreground="#71809A"/>

                            <TextBlock x:Name="OwnStatusTextBlock"
                                       Margin="0,5,0,0"
                                       Text="Проверка..."
                                       FontSize="13"
                                       Foreground="#DCE5F5"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>


            <!-- CONNECT TO FRIEND -->

            <Border Grid.Row="1"
                    MaxWidth="680"
                    HorizontalAlignment="Left"
                    Padding="24"
                    Margin="0,0,0,18"
                    Background="#101A2D"
                    BorderBrush="#1D2A42"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="Подключиться к другу"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Введите адрес WorldHub друга, который находится с вами в одной сети Radmin VPN."
                               Margin="0,7,0,22"
                               FontSize="13"
                               Foreground="#71809A"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="IP-адрес друга"
                               FontSize="12"
                               Foreground="#A9B7CC"/>

                    <TextBox x:Name="HostTextBox"
                             Height="42"
                             Margin="0,7,0,18"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Например: 26.12.45.20"/>

                    <TextBlock Text="Порт WorldHub друга"
                               FontSize="12"
                               Foreground="#A9B7CC"/>

                    <TextBox x:Name="PortTextBox"
                             Height="42"
                             Margin="0,7,0,20"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Порт, который указан у друга в разделе «Ваш WorldHub»"/>

                    <Button x:Name="ConnectButton"
                            Content="Подключиться"
                            Width="180"
                            Height="42"
                            HorizontalAlignment="Left"
                            Click="ConnectButton_Click"/>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="#16233A"
                            CornerRadius="7">

                        <StackPanel>

                            <TextBlock Text="Статус подключения"
                                       FontSize="11"
                                       Foreground="#71809A"/>

                            <TextBlock x:Name="StatusTextBlock"
                                       Margin="0,6,0,0"
                                       Text="Не подключено"
                                       FontSize="14"
                                       Foreground="#DCE5F5"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>


            <!-- INSTRUCTIONS -->

            <Border Grid.Row="2"
                    MaxWidth="680"
                    HorizontalAlignment="Left"
                    Padding="24"
                    Background="#101A2D"
                    BorderBrush="#1D2A42"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="Как подключиться"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Margin="0,14,0,0"
                               Text="1. Вы и друг должны быть подключены к одной комнате Radmin VPN."
                               FontSize="13"
                               Foreground="#A9B7CC"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,9,0,0"
                               Text="2. Друг запускает WorldHub и отправляет вам свой адрес из блока «Ваш WorldHub»."
                               FontSize="13"
                               Foreground="#A9B7CC"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,9,0,0"
                               Text="3. Введите IP-адрес и порт друга в форме выше."
                               FontSize="13"
                               Foreground="#A9B7CC"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,9,0,0"
                               Text="4. Нажмите «Подключиться»."
                               FontSize="13"
                               Foreground="#A9B7CC"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,16,0,0"
                               Text="После успешной проверки связи WorldHub покажет результат в блоке «Статус подключения»."
                               FontSize="12"
                               Foreground="#71809A"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>