<UserControl
    x:Class="WorldHub.App.Views.Connection.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WorldHub.App.Views.Connection"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Margin="0,20,0,24">
            <TextBlock
                Text="Подключение"
                FontFamily="Inter"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#F2F4F7"/>

            <TextBlock
                Margin="0,5,0,0"
                Text="Управление общими пространствами и участниками"
                FontFamily="Inter"
                FontSize="12"
                Foreground="#8C95A3"/>
        </StackPanel>

        <!-- Выбор и создание -->
        <Border
            Grid.Row="1"
            Padding="22"
            Background="#151922"
            BorderBrush="#2A303B"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>
                <TextBlock
                    Text="WorldHub-серверы"
                    FontFamily="Inter"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#F2F4F7"/>

                <TextBlock
                    Margin="0,5,0,16"
                    Text="Выберите пространство или создайте новое"
                    FontFamily="Inter"
                    FontSize="11"
                    Foreground="#8C95A3"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="WorldHubServerComboBox"
                        Grid.Column="0"
                        Height="42"
                        Margin="0,0,12,0"
                        Padding="12,0"
                        Background="#1A1F29"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        Foreground="#F2F4F7"
                        FontFamily="Inter"
                        FontSize="13"
                        VerticalContentAlignment="Center"
                        SelectedValuePath="Id"
                        SelectionChanged="WorldHubServerComboBox_SelectionChanged">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontFamily="Inter"
                                    FontSize="13"
                                    Foreground="#F2F4F7"
                                    VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        Grid.Column="1"
                        Width="114"
                        Height="42"
                        Margin="0,0,12,0"
                        Content="+ Создать"
                        Background="#4C8DFF"
                        BorderBrush="#4C8DFF"
                        Foreground="White"
                        FontFamily="Inter"
                        FontSize="12"
                        Click="CreateWorldHubServerButton_Click"/>

                    <Button
                        x:Name="DeleteWorldHubServerButton"
                        Grid.Column="2"
                        Width="114"
                        Height="42"
                        Content="Удалить"
                        Background="#1A1F29"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        Foreground="#E56B6F"
                        FontFamily="Inter"
                        FontSize="12"
                        IsEnabled="False"
                        Click="DeleteWorldHubServerButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Содержимое выбранного пространства -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="22"
            Background="#151922"
            BorderBrush="#2A303B"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>
                <StackPanel
                    x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Выберите WorldHub-сервер"
                        FontFamily="Inter"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F2F4F7"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Здесь будут отображаться участники и состояние подключения."
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#8C95A3"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        MaxWidth="380"/>
                </StackPanel>

                <ScrollViewer
                    x:Name="SelectedServerScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">

                    <Grid
                        x:Name="SelectedServerPanel">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок пространства -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    x:Name="SelectedServerNameText"
                                    FontFamily="Inter"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F2F4F7"/>

                                <TextBlock
                                    x:Name="ParticipantCountText"
                                    Margin="0,4,0,0"
                                    FontFamily="Inter"
                                    FontSize="12"
                                    Foreground="#8C95A3"/>
                            </StackPanel>

                            <Button
                                x:Name="AddParticipantButton"
                                Grid.Column="1"
                                Width="170"
                                Height="36"
                                Content="+ Добавить участника"
                                Background="#4C8DFF"
                                BorderBrush="#4C8DFF"
                                Foreground="White"
                                FontFamily="Inter"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Click="AddParticipantButton_Click"/>
                        </Grid>

                        <!-- Radmin VPN -->
                        <local:RadminVpnStatusCard
                            x:Name="RadminCard"
                            Grid.Row="1"
                            Margin="0,16,0,0"/>

                        <!-- Общая папка Google Drive -->
                        <local:WorldHubFolderSection
                            x:Name="FolderSection"
                            Grid.Row="2"
                            Margin="0,12,0,0"/>

                        <!-- Участники -->
                        <local:WorldHubParticipantsSection
                            x:Name="ParticipantsSection"
                            Grid.Row="3"
                            Margin="0,16,0,0"/>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>