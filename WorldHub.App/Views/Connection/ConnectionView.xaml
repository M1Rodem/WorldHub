<UserControl
    x:Class="WorldHub.App.Views.Connection.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:local="clr-namespace:WorldHub.App.Views.Connection"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <StackPanel Margin="0,20,0,24">
            <TextBlock
                Text="Подключение"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock
                Margin="0,5,0,0"
                Text="Управление общими пространствами и участниками"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- ВЫБОР И СОЗДАНИЕ -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorder}"
            Padding="20">

            <StackPanel>
                <TextBlock
                    Text="WorldHub-серверы"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock
                    Margin="0,4,0,14"
                    Text="Выберите пространство или создайте новое"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="WorldHubServerComboBox"
                        Grid.Column="0"
                        Height="38"
                        Margin="0,0,10,0"
                        SelectedValuePath="Id"
                        SelectionChanged="WorldHubServerComboBox_SelectionChanged">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Height="38"
                        Width="108"
                        Margin="0,0,8,0"
                        Click="CreateWorldHubServerButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox
                                Width="12"
                                Height="12"
                                Margin="0,0,6,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/plus.svg"/>
                            <TextBlock
                                Text="Создать"
                                VerticalAlignment="Center"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="DeleteWorldHubServerButton"
                        Grid.Column="2"
                        Style="{StaticResource DangerButton}"
                        Height="38"
                        Width="92"
                        Content="Удалить"
                        IsEnabled="False"
                        Click="DeleteWorldHubServerButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- СОДЕРЖИМОЕ ВЫБРАННОГО ПРОСТРАНСТВА -->
        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorder}"
            Margin="0,12,0,0"
            Padding="20">

            <Grid>
                <StackPanel
                    x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Border
                        Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="{DynamicResource AccentPurpleSubtleBrush}"
                        BorderBrush="{DynamicResource AccentPurpleBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                        <svgc:SvgViewbox
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Source="/Assets/Icons/connection.svg"/>
                    </Border>

                    <TextBlock
                        Text="Выберите WorldHub-сервер"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Margin="0,6,0,0"
                        Text="Здесь будут отображаться участники и состояние подключения."
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        MaxWidth="380"/>
                </StackPanel>

                <ScrollViewer
                    x:Name="SelectedServerScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">

                    <Grid
                        x:Name="SelectedServerPanel">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок пространства -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    x:Name="SelectedServerNameText"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <TextBlock
                                    x:Name="ParticipantCountText"
                                    Margin="0,3,0,0"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button
                                x:Name="AddParticipantButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Width="168"
                                VerticalAlignment="Top"
                                Click="AddParticipantButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <svgc:SvgViewbox
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,6,0"
                                        Stretch="Uniform"
                                        Source="/Assets/Icons/plus.svg"/>
                                    <TextBlock
                                        Text="Добавить участника"
                                        VerticalAlignment="Center"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Radmin VPN -->
                        <local:RadminVpnStatusCard
                            x:Name="RadminCard"
                            Grid.Row="1"
                            Margin="0,16,0,0"/>

                        <!-- Общая папка Google Drive -->
                        <local:WorldHubFolderSection
                            x:Name="FolderSection"
                            Grid.Row="2"
                            Margin="0,12,0,0"/>

                        <!-- Участники -->
                        <local:WorldHubParticipantsSection
                            x:Name="ParticipantsSection"
                            Grid.Row="3"
                            Margin="0,16,0,0"/>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>