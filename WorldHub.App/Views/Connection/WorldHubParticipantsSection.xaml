<UserControl
    x:Class="WorldHub.App.Views.Connection.WorldHubParticipantsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <StackPanel>

        <TextBlock
            x:Name="ParticipantsEmptyText"
            Text="Пока нет ни одного участника. Добавьте друга по IP Radmin VPN."
            FontFamily="Inter, Segoe UI, sans-serif"
            FontSize="12"
            Foreground="{DynamicResource TextSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed"/>

        <ItemsControl
            x:Name="ParticipantsItemsControl">

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Style="{StaticResource InnerCardBorder}"
                        Margin="0,0,0,10"
                        Padding="16">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding DisplayName}"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{Binding OnlineBrush}"/>

                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding OnlineText}"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{Binding OnlineBrush}"/>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,3,0,0"
                                Text="{Binding Subtitle}"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="84"
                                Height="28"
                                Margin="12,3,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="Удалить"
                                Tag="{Binding}"
                                Click="RemoveParticipantButton_Click">

                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Height" Value="28"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,0,16,0">

                                    <TextBlock
                                        Text="Ping: "
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding PingStatusText}"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{Binding PingBrush}"/>
                                </StackPanel>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,0,16,0">

                                    <TextBlock
                                        Text="WorldHub: "
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding WorldHubStatusText}"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{Binding WorldHubBrush}"/>
                                </StackPanel>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,0,16,0">

                                    <TextBlock
                                        Text="Google Drive: "
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding GoogleDriveStatusText}"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{Binding GoogleDriveBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="Версия: "
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMutedBrush}"/>

                                    <TextBlock
                                        Text="{Binding VersionText}"
                                        FontFamily="Inter, Segoe UI, sans-serif"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <Button
                                    Style="{StaticResource SecondaryButton}"
                                    Width="96"
                                    Height="28"
                                    Padding="8,0"
                                    FontSize="11"
                                    Content="Проверить"
                                    Tag="{Binding}"
                                    Click="CheckParticipantButton_Click"/>
                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>
</UserControl>