<UserControl
    x:Class="WorldHub.App.Views.Connection.WorldHubFolderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Background="Transparent">

    <Border
        Style="{StaticResource InnerCardBorder}"
        Padding="16,14">

        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="34"
                    Height="34"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <svgc:SvgViewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Source="/Assets/Icons/cloud.svg"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="Общая папка Google Drive"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock
                        Margin="0,2,0,0"
                        Text="Синхронизация миров и резервных копий через облако"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Пока папка не создана -->
            <StackPanel x:Name="FolderNotCreatedPanel" Margin="0,12,0,0">

                <TextBlock
                    x:Name="FolderNotCreatedMessageText"
                    Text="Папка ещё не создана. Создайте её, чтобы синхронизировать миры с участниками. Доступ будет выдан всем автоматически."
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <Button
                    x:Name="CreateFolderButton"
                    Style="{StaticResource PrimaryButton}"
                    Width="200"
                    Height="34"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="CreateFolderButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            Stretch="Uniform"
                            Source="/Assets/Icons/plus.svg"/>
                        <TextBlock
                            Text="Создать общую папку"
                            VerticalAlignment="Center"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#FFFFFF"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Папка создана -->
            <!-- Папка создана -->
            <StackPanel
                x:Name="FolderCreatedPanel"
                Margin="0,12,0,0"
                Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            Text="Folder ID:"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextMutedBrush}"/>

                        <TextBlock
                            x:Name="FolderIdText"
                            Margin="0,3,0,0"
                            FontFamily="Consolas, monospace"
                            FontSize="11"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button
                        x:Name="OpenInGoogleDriveButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Height="32"
                        Margin="12,0,0,0"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Click="OpenInGoogleDriveButton_Click">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svgc:SvgViewbox
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Stretch="Uniform"
                                Source="/Assets/Icons/google-on.svg"/>
                            <TextBlock
                                Text="Открыть в Google Drive"
                                VerticalAlignment="Center"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                    </Button>

                </Grid>

                <TextBlock
                    x:Name="FolderAccessStatusText"
                    Margin="0,10,0,0"
                    Text="Доступ не проверен"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="FolderAccessTimeText"
                    Margin="0,2,0,0"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="10"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Visibility="Collapsed"/>

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>