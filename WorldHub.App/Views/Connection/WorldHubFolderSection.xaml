<UserControl
    x:Class="WorldHub.App.Views.Connection.WorldHubFolderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Border
        Padding="14"
        Background="#1A1F29"
        BorderBrush="#2A303B"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>

            <TextBlock
                Text="Общая папка Google Drive"
                FontFamily="Inter"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#F2F4F7"/>

            <!-- Пока папка не создана -->
            <StackPanel x:Name="FolderNotCreatedPanel">

                <TextBlock
                    Margin="0,8,0,0"
                    Text="Папка ещё не создана. Создайте её, чтобы в будущем синхронизировать миры через Google Drive."
                    FontFamily="Inter"
                    FontSize="11"
                    Foreground="#8C95A3"
                    TextWrapping="Wrap"/>

                <Button
                    x:Name="CreateFolderButton"
                    Width="200"
                    Height="34"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Content="Создать общую папку"
                    Background="#4C8DFF"
                    BorderBrush="#4C8DFF"
                    Foreground="White"
                    FontFamily="Inter"
                    FontSize="12"
                    Click="CreateFolderButton_Click"/>

            </StackPanel>

            <!-- Папка создана -->
            <StackPanel
                x:Name="FolderCreatedPanel"
                Visibility="Collapsed">

                <TextBlock
                    Margin="0,8,0,0"
                    Text="Folder ID:"
                    FontFamily="Inter"
                    FontSize="11"
                    Foreground="#8C95A3"/>

                <TextBlock
                    x:Name="FolderIdText"
                    Margin="0,3,0,0"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="#F2F4F7"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="FolderAccessStatusText"
                    Margin="0,8,0,0"
                    Text="Доступ не проверен"
                    FontFamily="Inter"
                    FontSize="11"
                    Foreground="#8C95A3"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="FolderAccessTimeText"
                    Margin="0,3,0,0"
                    FontFamily="Inter"
                    FontSize="10"
                    Foreground="#8C95A3"
                    Visibility="Collapsed"/>

                <StackPanel
                    Margin="0,10,0,0"
                    Orientation="Horizontal">

                    <Button
                        x:Name="CheckFolderAccessButton"
                        Width="160"
                        Height="32"
                        Padding="0"
                        Content="Проверить доступ"
                        Background="#1A1F29"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        Foreground="#F2F4F7"
                        FontFamily="Inter"
                        FontSize="11"
                        Click="CheckFolderAccessButton_Click"/>

                </StackPanel>

                <!-- Приглашение участника -->
                <Border
                    Margin="0,12,0,0"
                    Padding="10"
                    Background="#0E1117"
                    BorderBrush="#2A303B"
                    BorderThickness="1"
                    CornerRadius="5">

                    <StackPanel>

                        <TextBlock
                            Text="Пригласить участника в папку"
                            FontFamily="Inter"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#F2F4F7"/>

                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Введите Google-email участника. Он получит доступ редактора к папке."
                            FontFamily="Inter"
                            FontSize="10"
                            Foreground="#8C95A3"
                            TextWrapping="Wrap"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="ShareEmailTextBox"
                                Grid.Column="0"
                                Height="32"
                                Padding="8,0"
                                VerticalContentAlignment="Center"
                                Background="#1A1F29"
                                BorderBrush="#2A303B"
                                BorderThickness="1"
                                Foreground="#F2F4F7"
                                CaretBrush="#F2F4F7"
                                FontFamily="Inter"
                                FontSize="12"/>

                            <Button
                                x:Name="ShareFolderButton"
                                Grid.Column="1"
                                Width="120"
                                Height="32"
                                Margin="8,0,0,0"
                                Padding="0"
                                Content="Пригласить"
                                Background="#1A1F29"
                                BorderBrush="#2A303B"
                                BorderThickness="1"
                                Foreground="#F2F4F7"
                                FontFamily="Inter"
                                FontSize="11"
                                Click="ShareFolderButton_Click"/>

                        </Grid>

                        <TextBlock
                            x:Name="ShareResultText"
                            Margin="0,8,0,0"
                            FontFamily="Inter"
                            FontSize="10"
                            Foreground="#8C95A3"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
