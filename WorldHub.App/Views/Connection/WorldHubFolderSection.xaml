<UserControl
    x:Class="WorldHub.App.Views.Connection.WorldHubFolderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Background="Transparent">

    <Border
        Style="{StaticResource InnerCardBorder}"
        Padding="16,14">

        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="34"
                    Height="34"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <svgc:SvgViewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Source="/Assets/Icons/cloud.svg"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="Общая папка Google Drive"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock
                        Margin="0,2,0,0"
                        Text="Синхронизация миров и резервных копий через облако"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Пока папка не создана -->
            <StackPanel x:Name="FolderNotCreatedPanel" Margin="0,12,0,0">

                <TextBlock
                    Text="Папка ещё не создана. Создайте её, чтобы синхронизировать миры с участниками."
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <Button
                    x:Name="CreateFolderButton"
                    Style="{StaticResource PrimaryButton}"
                    Width="180"
                    Height="34"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="CreateFolderButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            Stretch="Uniform"
                            Source="/Assets/Icons/plus.svg"/>
                        <TextBlock
                            Text="Создать общую папку"
                            VerticalAlignment="Center"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#FFFFFF"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Папка создана -->
            <StackPanel
                x:Name="FolderCreatedPanel"
                Margin="0,12,0,0"
                Visibility="Collapsed">

                <TextBlock
                    Text="Folder ID:"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="11"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextMutedBrush}"/>

                <TextBlock
                    x:Name="FolderIdText"
                    Margin="0,3,0,0"
                    FontFamily="Consolas, monospace"
                    FontSize="11"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="FolderAccessStatusText"
                    Margin="0,8,0,0"
                    Text="Доступ не проверен"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="FolderAccessTimeText"
                    Margin="0,2,0,0"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="10"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Visibility="Collapsed"/>

                <StackPanel
                    Margin="0,10,0,0"
                    Orientation="Horizontal">

                    <Button
                        x:Name="CheckFolderAccessButton"
                        Style="{StaticResource SecondaryButton}"
                        Width="150"
                        Height="32"
                        Content="Проверить доступ"
                        Click="CheckFolderAccessButton_Click"/>

                </StackPanel>

                <!-- Приглашение участника -->
                <Border
                    Margin="0,12,0,0"
                    Padding="12"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                    <StackPanel>

                        <TextBlock
                            Text="Пригласить участника в папку"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock
                            Margin="0,3,0,0"
                            Text="Введите Google-email участника. Он получит доступ редактора к папке."
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="ShareEmailTextBox"
                                Grid.Column="0"
                                Height="32"
                                Padding="8,0"
                                VerticalContentAlignment="Center"/>

                            <Button
                                x:Name="ShareFolderButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Width="110"
                                Height="32"
                                Margin="8,0,0,0"
                                Content="Пригласить"
                                Click="ShareFolderButton_Click"/>

                        </Grid>

                        <TextBlock
                            x:Name="ShareResultText"
                            Margin="0,6,0,0"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
