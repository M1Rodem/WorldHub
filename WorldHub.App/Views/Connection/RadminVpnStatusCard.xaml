<UserControl
    x:Class="WorldHub.App.Views.Connection.RadminVpnStatusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Border
        Padding="14"
        Background="#1A1F29"
        BorderBrush="#2A303B"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>
            <TextBlock
                Text="Сеть Radmin VPN"
                FontFamily="Inter"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#F2F4F7"/>

            <TextBlock
                x:Name="RadminVpnStatusText"
                Margin="0,8,0,0"
                Text="Проверка..."
                FontFamily="Inter"
                FontSize="12"
                Foreground="#A9B1BF"/>

            <TextBlock
                x:Name="RadminVpnAddressText"
                Margin="0,4,0,0"
                Text="IP: —"
                FontFamily="Inter"
                FontSize="12"
                Foreground="#8C95A3"/>
        </StackPanel>
    </Border>
</UserControl>
