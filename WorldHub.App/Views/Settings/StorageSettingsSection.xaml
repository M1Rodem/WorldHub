<UserControl
    x:Class="WorldHub.App.Views.Settings.StorageSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Background="Transparent">

    <Border
        Style="{StaticResource CardBorder}"
        Padding="20">

        <StackPanel>

            <TextBlock
                Text="Хранилище WorldHub"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock
                Margin="0,3,0,0"
                Text="Локальная папка для хранения конфигураций и данных серверов"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Border
                Style="{StaticResource InnerCardBorder}"
                Margin="0,14,0,0"
                Height="40">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <svgc:SvgViewbox
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Source="/Assets/Icons/folder.svg"/>

                    <TextBlock
                        x:Name="DataPathText"
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
            </Border>

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal">

                <Button
                    x:Name="ChangeDataPathButton"
                    Style="{StaticResource SecondaryButton}"
                    Height="34"
                    Padding="14,0"
                    Content="Изменить папку"
                    Click="ChangeDataPathButton_Click"/>

                <Button
                    x:Name="ResetDataPathButton"
                    Style="{StaticResource SecondaryButton}"
                    Height="34"
                    Margin="8,0,0,0"
                    Padding="14,0"
                    Content="Сбросить"
                    Click="ResetDataPathButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
