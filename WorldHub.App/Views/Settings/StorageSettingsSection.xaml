<UserControl
    x:Class="WorldHub.App.Views.Settings.StorageSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Background="Transparent">

    <Border
        Padding="22"
        Background="#151922"
        BorderBrush="#2A303B"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>

            <TextBlock
                Text="Хранилище WorldHub"
                FontFamily="Inter"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="#F2F4F7"/>

            <TextBlock
                Margin="0,5,0,0"
                Text="Папка данных"
                FontFamily="Inter"
                FontSize="11"
                FontWeight="Medium"
                Foreground="#8C95A3"/>

            <Border
                Margin="0,7,0,0"
                Height="42"
                Background="#1A1F29"
                BorderBrush="#2A303B"
                BorderThickness="1"
                CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <svgc:SvgViewbox
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Source="/Assets/Icons/folder.svg"/>

                    <TextBlock
                        x:Name="DataPathText"
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        FontFamily="Inter"
                        FontSize="12"
                        Foreground="#F2F4F7"/>
                </Grid>
            </Border>

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal">

                <Button
                    x:Name="ChangeDataPathButton"
                    Width="145"
                    Height="36"
                    Padding="0"
                    Content="Изменить папку"
                    Background="#1A1F29"
                    BorderBrush="#2A303B"
                    BorderThickness="1"
                    Foreground="#F2F4F7"
                    FontFamily="Inter"
                    FontSize="12"
                    Click="ChangeDataPathButton_Click"/>

                <Button
                    x:Name="ResetDataPathButton"
                    Width="100"
                    Height="36"
                    Margin="8,0,0,0"
                    Padding="0"
                    Content="Сбросить"
                    Background="#1A1F29"
                    BorderBrush="#2A303B"
                    Foreground="#F2F4F7"
                    FontFamily="Inter"
                    FontSize="12"
                    Click="ResetDataPathButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
