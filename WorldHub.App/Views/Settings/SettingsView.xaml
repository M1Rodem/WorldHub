<UserControl
    x:Class="WorldHub.App.Views.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WorldHub.App.Views.Settings"
    Background="Transparent">

    <Grid>

        <!-- HEADER -->
        <Grid
            Margin="0,20,0,0"
            VerticalAlignment="Top">

            <StackPanel
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Настройки"
                    FontFamily="Inter"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#F2F4F7"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Настройки WorldHub"
                    FontFamily="Inter"
                    FontSize="12"
                    Foreground="#8C95A3"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"/>

            </StackPanel>

        </Grid>

        <ScrollViewer
            Margin="0,94,15,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- ПРОФИЛЬ -->
                <local:ProfileSettingsSection
                    x:Name="ProfileSection"/>

                <!-- ХРАНИЛИЩЕ WORLDHUB -->
                <local:StorageSettingsSection
                    x:Name="StorageSection"
                    Margin="0,12,0,0"/>

                <!-- ОБНОВЛЕНИЯ -->
                <local:UpdateSettingsSection
                    x:Name="UpdateSection"
                    Margin="0,12,0,0"/>

                <!-- О ПРОГРАММЕ -->
                <Border
                    Margin="0,12,0,20"
                    Padding="22"
                    Background="#151922"
                    BorderBrush="#2A303B"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="О программе"
                            FontFamily="Inter"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#F2F4F7"/>

                        <TextBlock
                            Margin="0,14,0,0"
                            Text="WorldHub"
                            FontFamily="Inter"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#F2F4F7"/>

                        <TextBlock
                            Margin="0,5,0,0"
                            Text="Менеджер локальных Minecraft Dedicated Server"
                            FontFamily="Inter"
                            FontSize="12"
                            Foreground="#8C95A3"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>