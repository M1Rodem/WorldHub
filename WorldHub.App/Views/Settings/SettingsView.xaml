<UserControl
    x:Class="WorldHub.App.Views.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:local="clr-namespace:WorldHub.App.Views.Settings"
    Background="Transparent">

    <Grid>

        <!-- HEADER -->
        <Grid
            Margin="0,20,0,0"
            VerticalAlignment="Top">

            <StackPanel
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Настройки"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Настройки WorldHub и интеграций"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"/>

            </StackPanel>

        </Grid>

        <ScrollViewer
            Margin="0,84,15,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- ПРОФИЛЬ -->
                <local:ProfileSettingsSection
                    x:Name="ProfileSection"/>

                <!-- ХРАНИЛИЩЕ WORLDHUB -->
                <local:StorageSettingsSection
                    x:Name="StorageSection"
                    Margin="0,12,0,0"/>

                <!-- ОБНОВЛЕНИЯ -->
                <local:UpdateSettingsSection
                    x:Name="UpdateSection"
                    Margin="0,12,0,0"/>

                <!-- О ПРОГРАММЕ -->
                <Border
                    Style="{StaticResource CardBorder}"
                    Margin="0,12,0,24"
                    Padding="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="{DynamicResource AccentPurpleSubtleBrush}"
                            BorderBrush="{DynamicResource AccentPurpleBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <svgc:SvgViewbox
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Source="/Assets/Icons/server.svg"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                Text="WorldHub"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock
                                Margin="0,3,0,0"
                                Text="Менеджер локальных Minecraft Dedicated Server и облачной синхронизации"
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>