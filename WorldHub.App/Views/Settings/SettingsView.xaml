<UserControl
    x:Class="WorldHub.App.Views.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:local="clr-namespace:WorldHub.App.Views.Settings"
    Background="Transparent">

    <Grid>

        <!-- HEADER -->
        <Grid
            Margin="0,20,0,0"
            VerticalAlignment="Top">

            <StackPanel
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Настройки"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Настройки WorldHub и интеграций"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"/>

            </StackPanel>

        </Grid>

        <ScrollViewer
            Margin="0,84,15,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- ПРОФИЛЬ -->
                <local:ProfileSettingsSection
                    x:Name="ProfileSection"/>

                <!-- ХРАНИЛИЩЕ WORLDHUB -->
                <local:StorageSettingsSection
                    x:Name="StorageSection"
                    Margin="0,12,0,0"/>

                <!-- ОБНОВЛЕНИЯ -->
                <local:UpdateSettingsSection
                    x:Name="UpdateSection"
                    Margin="0,12,0,0"/>

                <!-- О ПРОГРАММЕ -->
                <Border
                    Style="{StaticResource CardBorder}"
                    Margin="0,12,0,24"
                    Padding="20">

                    <StackPanel>

                        <TextBlock
                            Text="О программе"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock
                            Margin="0,12,0,0"
                            Text="WorldHub"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock
                            Margin="0,5,0,0"
                            Text="Менеджер локальных Minecraft Dedicated Server и облачной синхронизации. Управляет группами участников через Radmin VPN и общими папками Google Drive."
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap"/>

                        <StackPanel
                            Margin="0,16,0,0"
                            Orientation="Horizontal">

                            <TextBlock
                                Text="GitHub: "
                                FontFamily="Inter, Segoe UI, sans-serif"
                                FontSize="12"
                                Foreground="{DynamicResource TextMutedBrush}"/>

                            <Button
                                x:Name="GitHubLinkButton"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Click="GitHubLinkButton_Click">

                                <TextBlock
                                    Text="https://github.com/M1Rodem/WorldHub"
                                    FontFamily="Inter, Segoe UI, sans-serif"
                                    FontSize="12"
                                    Foreground="{DynamicResource AccentPurpleBrush}"
                                    TextDecorations="Underline"/>

                            </Button>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>