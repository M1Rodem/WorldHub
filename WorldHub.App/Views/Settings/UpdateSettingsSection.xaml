<UserControl
    x:Class="WorldHub.App.Views.Settings.UpdateSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Border
        Padding="22"
        Background="#151922"
        BorderBrush="#2A303B"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>

            <TextBlock
                Text="Обновления"
                FontFamily="Inter"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="#F2F4F7"/>

            <StackPanel
                Margin="0,14,0,0"
                Orientation="Horizontal">

                <TextBlock
                    Text="Версия: "
                    FontFamily="Inter"
                    FontSize="12"
                    Foreground="#8C95A3"/>

                <TextBlock
                    x:Name="AppVersionText"
                    FontFamily="Inter"
                    FontSize="12"
                    Foreground="#F2F4F7"/>

                <TextBlock
                    Margin="24,0,0,0"
                    Text="Платформа: Windows x64"
                    FontFamily="Inter"
                    FontSize="12"
                    Foreground="#8C95A3"/>
            </StackPanel>

            <TextBlock
                x:Name="UpdateStatusText"
                Margin="0,14,0,0"
                Text="● Проверка ещё не выполнялась"
                FontFamily="Inter"
                FontSize="12"
                Foreground="#A9B1BF"/>

            <TextBlock
                x:Name="LatestVersionText"
                Margin="0,4,0,0"
                FontFamily="Inter"
                FontSize="11"
                Foreground="#8C95A3"
                Visibility="Collapsed"/>

            <TextBlock
                x:Name="LastUpdateCheckText"
                Margin="0,4,0,0"
                FontFamily="Inter"
                FontSize="11"
                Foreground="#8C95A3"
                Visibility="Collapsed"/>

            <StackPanel
                Margin="0,14,0,0"
                Orientation="Horizontal">

                <Button
                    x:Name="CheckUpdateButton"
                    Width="180"
                    Height="36"
                    Padding="0"
                    Content="Проверить обновления"
                    Background="#1A1F29"
                    BorderBrush="#2A303B"
                    BorderThickness="1"
                    Foreground="#F2F4F7"
                    FontFamily="Inter"
                    FontSize="12"
                    Click="CheckUpdateButton_Click"/>

                <Button
                    x:Name="UpdateButton"
                    Width="105"
                    Height="36"
                    Margin="8,0,0,0"
                    Padding="0"
                    Content="Обновить"
                    Background="#4C8DFF"
                    BorderBrush="#4C8DFF"
                    BorderThickness="1"
                    Foreground="#FFFFFF"
                    FontFamily="Inter"
                    FontSize="12"
                    IsEnabled="False"
                    Click="UpdateButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
