<UserControl
    x:Class="WorldHub.App.Views.Settings.UpdateSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Border
        Style="{StaticResource CardBorder}"
        Padding="20">

        <StackPanel>

            <TextBlock
                Text="Обновления"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal">

                <TextBlock
                    Text="Версия: "
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock
                    x:Name="AppVersionText"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock
                    Margin="20,0,0,0"
                    Text="Платформа: Windows x64"
                    FontFamily="Inter, Segoe UI, sans-serif"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <TextBlock
                x:Name="UpdateStatusText"
                Margin="0,12,0,0"
                Text="● Проверка ещё не выполнялась"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBlock
                x:Name="LatestVersionText"
                Margin="0,4,0,0"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Visibility="Collapsed"/>

            <TextBlock
                x:Name="LastUpdateCheckText"
                Margin="0,4,0,0"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                Foreground="{DynamicResource TextMutedBrush}"
                Visibility="Collapsed"/>

            <StackPanel
                Margin="0,14,0,0"
                Orientation="Horizontal">

                <Button
                    x:Name="CheckUpdateButton"
                    Style="{StaticResource SecondaryButton}"
                    Height="34"
                    Padding="14,0"
                    Content="Проверить обновления"
                    Click="CheckUpdateButton_Click"/>

                <Button
                    x:Name="UpdateButton"
                    Style="{StaticResource PrimaryButton}"
                    Height="34"
                    Margin="8,0,0,0"
                    Padding="16,0"
                    Content="Обновить"
                    IsEnabled="False"
                    Click="UpdateButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
