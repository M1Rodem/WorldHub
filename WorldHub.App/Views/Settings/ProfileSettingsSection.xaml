<UserControl
    x:Class="WorldHub.App.Views.Settings.ProfileSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Background="Transparent">

    <Border
        Style="{StaticResource CardBorder}"
        Padding="20">

        <StackPanel>

            <TextBlock
                Text="Профиль"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock
                Margin="0,3,0,0"
                Text="Ваш профиль WorldHub и привязанные сервисы"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- НИК -->
            <TextBlock
                Margin="0,16,0,0"
                Text="Никнейм"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource TextMutedBrush}"/>

            <Border
                Style="{StaticResource InnerCardBorder}"
                Margin="0,6,0,0"
                Height="40">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="13">

                        <svgc:SvgViewbox
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Source="/Assets/Icons/user.svg"/>
                    </Border>

                    <TextBox
                        x:Name="UserNameTextBox"
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        CaretBrush="{DynamicResource AccentPurpleBrush}"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="13"
                        TextChanged="UserNameTextBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- GOOGLE АККАУНТ -->
            <TextBlock
                Margin="0,16,0,0"
                Text="Google аккаунт"
                FontFamily="Inter, Segoe UI, sans-serif"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource TextMutedBrush}"/>

            <Border
                Style="{StaticResource InnerCardBorder}"
                Margin="0,6,0,0"
                Height="42">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="13">

                        <svgc:SvgViewbox
                            x:Name="GoogleAccountIcon"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Source="/Assets/Icons/google-off.svg"/>
                    </Border>

                    <TextBlock
                        x:Name="GoogleAccountText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Google аккаунт не подключен"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <Button
                        x:Name="GoogleConnectButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        Height="30"
                        Padding="12,0"
                        Margin="8,0,8,0"
                        Content="Подключить"
                        Click="GoogleConnectButton_Click"/>
                </Grid>
            </Border>

            <!-- ПРОВЕРКА ПОДКЛЮЧЕНИЯ -->
            <Border
                Style="{StaticResource InnerCardBorder}"
                Margin="0,8,0,0"
                Padding="14,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            Text="Проверка доступа к Google Drive"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock
                            x:Name="DriveCheckStatusText"
                            Margin="0,3,0,0"
                            Text="Проверка ещё не выполнялась"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            x:Name="DriveCheckTimeText"
                            Margin="0,2,0,0"
                            FontFamily="Inter, Segoe UI, sans-serif"
                            FontSize="10"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Visibility="Collapsed"/>
                    </StackPanel>

                    <Button
                        x:Name="DriveCheckButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Height="32"
                        Padding="12,0"
                        Margin="12,0,0,0"
                        Content="Проверить подключение"
                        VerticalAlignment="Center"
                        Click="DriveCheckButton_Click"/>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
