<UserControl x:Class="WorldHub.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- WORLDS -->
            <Border Padding="24" Background="#101A2D" BorderBrush="#1D2A42" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Управление мирами" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Выберите миры, которые хотите удалить из WorldHub." Margin="0,6,0,20" FontSize="13" Foreground="#71809A"/>
                    <!-- WORLD TABLE -->
                    <Border Background="#0B1220" BorderBrush="#1D2A42" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- TABLE HEADER -->
                            <Border Grid.Row="0" Background="#16233A">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Мир" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#A9B7CC"/>
                                    <TextBlock Grid.Column="2" Text="Minecraft" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#A9B7CC"/>
                                    <TextBlock Grid.Column="3" Text="Состояние" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#A9B7CC"/>
                                </Grid>
                            </Border>
                            <!-- WORLD LIST -->
                            <ScrollViewer Grid.Row="1" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WorldsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1D2A42" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- CHECKBOX -->
                                                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                    <!-- WORLD -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                        <TextBlock Text="{Binding LocalPath}" Margin="0,4,0,0" FontSize="11" Foreground="#71809A" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <!-- MINECRAFT -->
                                                    <TextBlock Grid.Column="2" Text="{Binding MinecraftVersion}" VerticalAlignment="Center" Foreground="#A9B7CC"/>
                                                    <!-- STATUS -->
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#A9B7CC"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <!-- DELETE -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Удаление" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Удаление убирает мир только из WorldHub. Физическая папка Minecraft не удаляется." Margin="0,5,0,12" FontSize="12" Foreground="#71809A"/>
                        <Button Content="Удалить выбранные миры" Width="210" Height="40" HorizontalAlignment="Left" Click="DeleteWorldButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- OTHER SETTINGS -->
            <!-- OTHER SETTINGS -->
            <Border Margin="0,20,0,0"
        Padding="24"
        Background="#101A2D"
        BorderBrush="#1D2A42"
        BorderThickness="1"
        CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Общие настройки"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                    <TextBlock Text="Настройки хранения локальных данных WorldHub."
                   Margin="0,6,0,20"
                   FontSize="13"
                   Foreground="#71809A"/>

                    <TextBlock Text="Папка данных"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                    <TextBlock x:Name="DataPathText"
                   Margin="0,5,0,12"
                   FontSize="12"
                   Foreground="#A9B7CC"
                   TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ChangeDataPathButton"
                            Content="Изменить папку"
                            Width="150"
                            Height="36"
                            HorizontalAlignment="Left"
                            Click="ChangeDataPathButton_Click"/>

                        <Button x:Name="ResetDataPathButton"
                            Content="Сбросить"
                            Width="110"
                            Height="36"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            Click="ResetDataPathButton_Click"/>
                    </StackPanel>
                </StackPanel>

            </Border>
            <!-- ABOUT -->
            <Border Margin="0,20,0,0"
        Padding="20"
        Background="#101A2D"
        BorderBrush="#1D2A42"
        BorderThickness="1"
        CornerRadius="12">
                <StackPanel>

                    <TextBlock Text="О программе"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                    <TextBlock Text="WorldHub"
                   Margin="0,6,0,0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#A9B7CC"/>

                    <TextBlock Text="Приложение для управления Minecraft-миром"
                   Margin="0,2,0,12"
                   FontSize="12"
                   Foreground="#71809A"/>

                    <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,14">

                        <TextBlock Text="Версия: "
                       FontSize="12"
                       Foreground="#71809A"/>

                        <TextBlock x:Name="AppVersionText"
                       FontSize="12"
                       Foreground="#A9B7CC"/>

                        <TextBlock Text="    Платформа: Windows x64"
                       FontSize="12"
                       Foreground="#71809A"/>

                    </StackPanel>

                    <TextBlock Text="Обновления"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                    <TextBlock x:Name="UpdateStatusText"
                   Margin="0,4,0,0"
                   Text="● Проверка ещё не выполнялась"
                   FontSize="12"
                   Foreground="#A9B7CC"/>

                    <TextBlock x:Name="LatestVersionText"
                   Margin="0,3,0,0"
                   FontSize="12"
                   Foreground="#71809A"
                   Visibility="Collapsed"/>

                    <TextBlock x:Name="LastUpdateCheckText"
                   Margin="0,3,0,14"
                   FontSize="11"
                   Foreground="#71809A"
                   Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="CheckUpdateButton"
                    Content="Проверить обновления"
                    Width="190"
                    Height="36"
                    Click="CheckUpdateButton_Click"/>

                        <Button x:Name="UpdateButton"
                    Content="Обновить"
                    Margin="8,0,0,0"
                    Width="110"
                    Height="36"
                    IsEnabled="False"
                    Click="UpdateButton_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>